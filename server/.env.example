# ===========================================
# REQUIRED - MongoDB Atlas (Free)
# Get from: mongodb.com/atlas
# ===========================================
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/modernselfdrive?retryWrites=true&w=majority

# ===========================================
# REQUIRED - JWT Secret
# Generate by running: openssl rand -base64 32
# ===========================================
JWT_SECRET=your-super-secret-key-minimum-32-characters

# ===========================================
# REQUIRED - Cloudinary (Free)
# Get from: cloudinary.com/settings
# ===========================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ===========================================
# OPTIONAL - Server
# ===========================================
NODE_ENV=production
PORT=5000

# Production URL - update when deploying
CLIENT_URL_PROD=https://your-domain.com

# ===========================================
# OPTIONAL - Payment (Razorpay)
# Get from: razorpay.com/dashboard
# ===========================================
# PAYMENT_GATEWAY=razorpay
# RAZORPAY_KEY_ID=your-key-id
# RAZORPAY_KEY_SECRET=your-key-secret

# ===========================================
# OPTIONAL - Google Maps
# Get from: console.cloud.google.com
# ===========================================
# MAPS_API_KEY=your-maps-api-key