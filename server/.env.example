# ═══════════════════════════════════════════════════════════
# Modern Selfdrive Car — Server Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.

# SECURITY NOTE: JWT_SECRET must be minimum 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/moderndrive
JWT_SECRET=your_64_char_hex_secret_here
JWT_EXPIRES_IN=30d

# CORS — production frontend domain
CLIENT_URL=http://localhost:5173
CLIENT_URL_PROD=https://your-production-domain.com

# Business contact info
BUSINESS_NAME=Modern Selfdrive Car
BUSINESS_PHONE=+918792492717
BUSINESS_WHATSAPP=918792492717
BUSINESS_EMAIL=info@modernselfdrivecar.com
BUSINESS_ADDRESS=GIDC 1 Joshipara Junagadh 362002 Gujarat
BUSINESS_CITY=Junagadh
BUSINESS_STATE=Gujarat

# Currency
CURRENCY=INR
CURRENCY_SYMBOL=₹
