{
  "name": "modern-selfdrive-api",
  "version": "2.0.0",
  "description": "Modern Selfdrive Car Rental API — Production Backend (Render)",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "tsx watch src/server.js",
    "seed": "tsx src/seed.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "test": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --import tsx\" DISABLE_RATE_LIMIT=true jest --runInBand --forceExit",
    "test:coverage": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --import tsx\" DISABLE_RATE_LIMIT=true jest --coverage --runInBand --forceExit"
  },
  "dependencies": {
    "@sentry/node": "^10.52.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.77.0",
    "cloudinary": "^1.41.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-prom-bundle": "^8.0.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "express-winston": "^4.2.0",
    "google-auth-library": "^10.6.2",
    "google-spreadsheet": "^5.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.10.1",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.9.7",
    "opossum": "^9.0.0",
    "prom-client": "^15.1.3",
    "razorpay": "^2.9.2",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.21.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.2",
    "cross-env": "^10.1.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.1.0",
    "prettier": "^3.1.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "20.x"
  }
}
